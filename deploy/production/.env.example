# Copy to deploy/production/.env on the website machine and fill in.
POSTGRES_PASSWORD=
SECRET_KEY=
# `backend` and `localhost` are the in-stack callers (frontend build, healthcheck).
ALLOWED_HOSTS=cora.repeatability.cps.cit.tum.de,cpsvm5.cit.tum.de,backend,localhost
CSRF_TRUSTED_ORIGINS=https://cora.repeatability.cps.cit.tum.de,http://cpsvm5.cit.tum.de:5175
# Must be reachable from the job containers on the worker machine.
ROOT_URL=https://cora.repeatability.cps.cit.tum.de
# Host ports; the defaults sit next to the VNN stack (8001/5174/5433).
WEB_PORT=5175
BACKEND_PORT=8002
DB_PORT=5434
MAX_PARALLEL_NODES=1
